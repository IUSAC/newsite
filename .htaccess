# Strona zawsze w najnowszej wersji: przeglądarka sprawdza HTML przy każdym wejściu.
<IfModule mod_headers.c>
  <FilesMatch "\.html?$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
# Serwer (LiteSpeed na Seohost) nie zapamiętuje gotowych stron – po publikacji od razu widać nową wersję.
<IfModule LiteSpeed>
  CacheDisable public /
  CacheDisable private /
</IfModule>
